# Normalise line endings for text files
* text=auto

# Unity YAML files: let git merge them as text
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.mat      text eol=lf
*.meta     text eol=lf
*.asmdef   text eol=lf
*.json     text eol=lf
*.cs       text eol=lf
*.md       text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.bat      text eol=crlf
*.ps1      text eol=crlf
*.sh       text eol=lf
*.yml      text eol=lf
